<?xml version='1.0' encoding='UTF-8'?>
<!-- Template, expanded by reynolds_rules.launch.py:
       {robot}                   replaced by the monitor_robot argument
       foreach_robot="true"      element repeated once per robot, {i} replaced by the robot index
                                 and {color} by a color of the palette
       {i} in selected_topics    topic repeated once per robot
-->
<root>
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab tab_name="Navigation" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="0.500000;0.500000" count="2">
     <DockArea name="Centroid distance to the goal [m]: straight line / along the path">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="1" top="1" bottom="0"/>
       <limitY min="0"/>
       <curve name="/flock/goal_distance/data" color="#1f77b4"/>
       <curve name="/flock/path_distance/data" color="#ff7f0e"/>
      </plot>
     </DockArea>
     <DockArea name="Centroid speed [m/s]: commanded / actual">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="1" top="0.4" bottom="0"/>
       <limitY min="0"/>
       <curve name="/flock/cmd_speed/data" color="#1f77b4"/>
       <curve name="/flock/speed/data" color="#d62728"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Trajectories" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="1" count="1">
     <DockArea name="Robot and centroid trajectories (x, y) [m]">
      <plot mode="XYPlot" style="Lines" flip_x="false" flip_y="false">
       <range left="-5" right="5" top="5" bottom="-5"/>
       <limitY/>
       <curve foreach_robot="true" name="robot_{i}" curve_x="/robot_{i}/odom/pose/pose/position/x" curve_y="/robot_{i}/odom/pose/pose/position/y" color="{color}"/>
       <curve name="centroid" curve_x="/flock/centroid/point/x" curve_y="/flock/centroid/point/y" color="#000000"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Velocities robot_{robot}" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="0.500000;0.500000" count="2">
     <DockArea name="robot_{robot} vx: commanded vs actual">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="1" top="1" bottom="-1"/>
       <limitY/>
       <curve name="/robot_{robot}/cmd_vel/linear/x" color="#1f77b4"/>
       <curve name="/robot_{robot}/odom/twist/twist/linear/x" color="#d62728"/>
      </plot>
     </DockArea>
     <DockArea name="robot_{robot} vy: commanded vs actual">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="1" top="1" bottom="-1"/>
       <limitY/>
       <curve name="/robot_{robot}/cmd_vel/linear/y" color="#1f77b4"/>
       <curve name="/robot_{robot}/odom/twist/twist/linear/y" color="#d62728"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Velocities robots 0-3" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="0.500000;0.500000" count="2">
     <DockSplitter orientation="|" sizes="0.500000;0.500000" count="2">
      <DockArea name="robot_0 velocities">
       <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
        <range left="0" right="1" top="1" bottom="-1"/>
        <limitY/>
        <curve name="/robot_0/cmd_vel/linear/x" color="#1f77b4"/>
        <curve name="/robot_0/odom/twist/twist/linear/x" color="#d62728"/>
        <curve name="/robot_0/cmd_vel/linear/y" color="#2ca02c"/>
        <curve name="/robot_0/odom/twist/twist/linear/y" color="#ff7f0e"/>
       </plot>
      </DockArea>
      <DockArea name="robot_1 velocities">
       <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
        <range left="0" right="1" top="1" bottom="-1"/>
        <limitY/>
        <curve name="/robot_1/cmd_vel/linear/x" color="#1f77b4"/>
        <curve name="/robot_1/odom/twist/twist/linear/x" color="#d62728"/>
        <curve name="/robot_1/cmd_vel/linear/y" color="#2ca02c"/>
        <curve name="/robot_1/odom/twist/twist/linear/y" color="#ff7f0e"/>
       </plot>
      </DockArea>
     </DockSplitter>
     <DockSplitter orientation="|" sizes="0.500000;0.500000" count="2">
      <DockArea name="robot_2 velocities">
       <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
        <range left="0" right="1" top="1" bottom="-1"/>
        <limitY/>
        <curve name="/robot_2/cmd_vel/linear/x" color="#1f77b4"/>
        <curve name="/robot_2/odom/twist/twist/linear/x" color="#d62728"/>
        <curve name="/robot_2/cmd_vel/linear/y" color="#2ca02c"/>
        <curve name="/robot_2/odom/twist/twist/linear/y" color="#ff7f0e"/>
       </plot>
      </DockArea>
      <DockArea name="robot_3 velocities">
       <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
        <range left="0" right="1" top="1" bottom="-1"/>
        <limitY/>
        <curve name="/robot_3/cmd_vel/linear/x" color="#1f77b4"/>
        <curve name="/robot_3/odom/twist/twist/linear/x" color="#d62728"/>
        <curve name="/robot_3/cmd_vel/linear/y" color="#2ca02c"/>
        <curve name="/robot_3/odom/twist/twist/linear/y" color="#ff7f0e"/>
       </plot>
      </DockArea>
     </DockSplitter>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Accelerations robot_{robot}" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="1" count="1">
     <DockArea name="robot_{robot} acceleration magnitude [m/s^2]: alignment / cohesion / separation / obstacle / navigation">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="1" top="1" bottom="0"/>
       <limitY min="0"/>
       <curve name="/robot_{robot}/reynolds/alignment/magnitude/data" color="#1f77b4"/>
       <curve name="/robot_{robot}/reynolds/cohesion/magnitude/data" color="#d62728"/>
       <curve name="/robot_{robot}/reynolds/separation/magnitude/data" color="#2ca02c"/>
       <curve name="/robot_{robot}/reynolds/obstacle/magnitude/data" color="#ff7f0e"/>
       <curve name="/robot_{robot}/reynolds/navigation/magnitude/data" color="#9467bd"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <!-- - - - - - - - - - - - - - - -->
 <Plugins>
  <plugin ID="ROS2 Topic Subscriber">
   <use_header_stamp value="false"/>
   <discard_large_arrays value="true"/>
   <max_array_size value="100"/>
   <boolean_strings_to_number value="true"/>
   <remove_suffix_from_strings value="true"/>
   <selected_topics value="/flock/goal_distance;/flock/path_distance;/flock/speed;/flock/cmd_speed;/flock/centroid;/robot_{i}/odom;/robot_{robot}/cmd_vel;/robot_{robot}/reynolds/alignment/magnitude;/robot_{robot}/reynolds/cohesion/magnitude;/robot_{robot}/reynolds/separation/magnitude;/robot_{robot}/reynolds/obstacle/magnitude;/robot_{robot}/reynolds/navigation/magnitude;/robot_0/cmd_vel;/robot_1/cmd_vel;/robot_2/cmd_vel;/robot_3/cmd_vel"/>
  </plugin>
 </Plugins>
 <previouslyLoaded_Datafiles/>
 <previouslyLoaded_Streamer name="ROS2 Topic Subscriber"/>
</root>
